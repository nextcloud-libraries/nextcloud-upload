msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "„{segment}“ není povoleno použít jako název souboru či složky."

msgid "\"{segment}\" is a forbidden file type."
msgstr "„{segment}“ není povoleného typu souboru."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "„{segment}“ není povoleno použít v rámci názvu souboru či složky."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "zbývá {seconds}"
msgstr[1] "zbývají {seconds}"
msgstr[2] "zbývá {seconds}"
msgstr[3] "zbývají {seconds}"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "zbývá {time}"

msgid "a few seconds left"
msgstr "zbývá několik sekund"

msgid "All files"
msgstr "Všechny soubory"

msgid "An item with the same name already exists in {dirname}."
msgstr "Stejně nazvaná položka už existuje v {dirname}."

msgid "assembling"
msgstr "sestavování"

msgid "Cancel"
msgstr "Zrušit"

msgid "Cancel the entire operation"
msgstr "Zrušit celou operaci"

msgid "Cancel uploads"
msgstr "Zrušit nahrávání"

msgid "Continue"
msgstr "Pokračovat"

msgid "Create new"
msgstr "Vytvořit nový"

msgid "estimating time left"
msgstr "odhaduje se zbývající čas"

msgid "Existing files"
msgstr "Existující soubory"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Pokud nebudou vybrány, existující soubory a složky budou smazány. Pokud jsou"
" oboje vybrány, budou přejmenovány."

msgid "Existing version"
msgstr "Existující verze"

msgid "Failed to assemble the chunks together"
msgstr "Shluky se nepodařilo dát dohromady"

msgid "Failed to upload the file"
msgstr "Soubor se nepodařilo nahrát"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Názvy souborů nemohou končit na „{segment}“."

msgid "Invalid filename"
msgstr "Neplatný název souboru"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Stejně nazvané položky už existují v {dirname} – vyberte, které ponechat."

msgid "Keep both"
msgstr "Ponechat obojí"

msgid "Last modified date unknown"
msgstr "Neznámé datum poslední úpravy"

msgid "New"
msgstr "Nové"

msgid "New filename"
msgstr "Nový název souboru"

msgid "New files"
msgstr "Nové soubory"

msgid "New version"
msgstr "Nová verze"

msgid "paused"
msgstr "pozastaveno"

msgid "Rename"
msgstr "Přejmenovat"

msgid "Replace"
msgstr "Nahradit"

msgid "Select all checkboxes"
msgstr "Označit všechny zaškrtávací kolonky"

msgid "Select file to keep"
msgstr "Vyberte soubor, který ponechat"

msgid "Select files to keep"
msgstr "Vyberte soubory, které ponechat"

msgid "Skip"
msgstr "Přeskočit"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Přeskočit {count} soubor"
msgstr[1] "Přeskočit {count} soubory"
msgstr[2] "Přeskočit {count} souborů"
msgstr[3] "Přeskočit {count} soubory"

msgid "Unknown size"
msgstr "Neznámá velikost"

msgid "Upload"
msgstr "Nahrát"

msgid "Upload files"
msgstr "Nahrát soubory"

msgid "Upload finished"
msgstr "Nahrávání dokončeno"

msgid "Upload finished: {count} file uploaded"
msgid_plural "Upload finished: {count} files uploaded"
msgstr[0] "Nahrání dokončeno: {count} soubor nahrán"
msgstr[1] "Nahrání dokončeno: {count} soubory nahrány"
msgstr[2] "Nahrání dokončeno: {count} souborů nahráno"
msgstr[3] "Nahrání dokončeno: {count} soubory nahrány"

msgid "Upload folders"
msgstr "Nahrát složky"

msgid "Upload from device"
msgstr "Nahrát ze zařízení"

msgid "Upload has been cancelled"
msgstr "Nahrávání bylo zrušeno"

msgid "Upload has been skipped"
msgstr "Nahrání bylo přeskočeno"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Nahrání „{folder}“ bylo přeskočeno"

msgid "Upload of \"{name}\" finished"
msgstr "Nahrání „{name}“ dokončeno"

msgid "Upload progress"
msgstr "Postup v nahrávání"

msgid "Upload progress: {progress}%"
msgstr "Postup v nahrávání: {progress}% "

msgid "Upload progress: {progress}%, total size {size}"
msgstr "Postup v nahrávání: {progress}%, celková velikost {size}"

msgid "Upload started"
msgstr "Nahrávání zahájeno"

msgid "Upload started: {count} file"
msgid_plural "Upload started: {count} files"
msgstr[0] "Nahrávání zahájeno: {count} soubor"
msgstr[1] "Nahrávání zahájeno: {count} soubory"
msgstr[2] "Nahrávání zahájeno: {count} souborů"
msgstr[3] "Nahrávání zahájeno: {count} soubory"

msgid "Upload started: {count} file ({size})"
msgid_plural "Upload started: {count} files ({size})"
msgstr[0] "Nahrávání zahájeno: {count} soubor ({size})"
msgstr[1] "Nahrávání zahájeno: {count} soubory ({size})"
msgstr[2] "Nahrávání zahájeno: {count} souborů ({size})"
msgstr[3] "Nahrávání zahájeno: {count} soubory ({size})"

msgid "Upload started: {name}"
msgstr "Nahrávání zahájeno: {name}"

msgid "Upload started: {name} ({size})"
msgstr "Nahrávání zahájeno: {name} ({size})"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Po výběru nové složky budou přepsány také jakékoli kolidující soubory."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Když je vybrána nová složka, obsah je zapsán do existující složky a je "
"provedeno rekurzivní řešení kolizí."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr "Soubor je možné buď přejmenovat, přeskočit nebo celou operaci zrušit."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Aby bylo možné pokračovat, je třeba vybrat alespoň jednu verzi od každého "
"souboru."
