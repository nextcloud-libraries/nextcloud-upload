msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "«{segment}» — запрещённое имя файла или папки."

msgid "\"{segment}\" is a forbidden file type."
msgstr "«{segment}» — запрещённый тип файла."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "«{segment}» нельзя использовать в имени файла или папки."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "осталась {seconds} секунда"
msgstr[1] "осталось {seconds} секунды"
msgstr[2] "осталось {seconds} секунд"
msgstr[3] "осталось {seconds} секунд"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "осталось {time}"

msgid "a few seconds left"
msgstr "осталось несколько секунд"

msgid "All files"
msgstr "Все файлы"

msgid "An item with the same name already exists in {dirname}."
msgstr "Объект с таким именем уже существует в {dirname}."

msgid "assembling"
msgstr "сборка"

msgid "Cancel"
msgstr "Отменить"

msgid "Cancel the entire operation"
msgstr "Отменить операцию целиком"

msgid "Cancel uploads"
msgstr "Отменить загрузки"

msgid "Continue"
msgstr "Продолжить"

msgid "Create new"
msgstr "Создать новое"

msgid "estimating time left"
msgstr "оценка оставшегося времени"

msgid "Existing files"
msgstr "Существующие файлы"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Невыбранные существующие файлы и папки будут удалены. Если выбрать и то, и "
"другое, они будут переименованы."

msgid "Existing version"
msgstr "Текущая версия"

msgid "Failed to assemble the chunks together"
msgstr "Не удалось собрать файл из частей"

msgid "Failed to upload the file"
msgstr "Не удалось загрузить файл"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Имена файлов не должны заканчиваться на «{segment}»."

msgid "Invalid filename"
msgstr "Недопустимое имя файла"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Объекты с такими же именами уже существуют в {dirname}. Выберите, какие "
"сохранить."

msgid "Keep both"
msgstr "Сохранить оба"

msgid "Last modified date unknown"
msgstr "Дата последнего изменения неизвестна"

msgid "New"
msgstr "Новый"

msgid "New filename"
msgstr "Новое имя файла"

msgid "New files"
msgstr "Новые файлы"

msgid "New version"
msgstr "Новая версия"

msgid "paused"
msgstr "приостановлено"

msgid "Rename"
msgstr "Переименовать"

msgid "Replace"
msgstr "Заменить"

msgid "Select all checkboxes"
msgstr "Выбрать все"

msgid "Select file to keep"
msgstr "Выберите, какой из файлов сохранить"

msgid "Select files to keep"
msgstr "Выберите, какие файлы сохранить"

msgid "Skip"
msgstr "Пропустить"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Пропустить {count} файл"
msgstr[1] "Пропустить {count} файла"
msgstr[2] "Пропустить {count} файлов"
msgstr[3] "Пропустить {count} файлов"

msgid "Unknown size"
msgstr "Неизвестный размер"

msgid "Upload"
msgstr "Загрузить"

msgid "Upload files"
msgstr "Загрузить файлы"

msgid "Upload finished"
msgstr "Загрузка завершена"

msgid "Upload finished: {count} file uploaded"
msgid_plural "Upload finished: {count} files uploaded"
msgstr[0] "Загрузка завершена: загружен {count} файл"
msgstr[1] "Загрузка завершена: загружено {count} файла"
msgstr[2] "Загрузка завершена: загружено {count} файлов"
msgstr[3] "Загрузка завершена: загружено {count} файла"

msgid "Upload folders"
msgstr "Загрузить папки"

msgid "Upload from device"
msgstr "Загрузить с устройства"

msgid "Upload has been cancelled"
msgstr "Загрузка отменена"

msgid "Upload has been skipped"
msgstr "Загрузка пропущена"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Загрузка «{folder}» пропущена"

msgid "Upload of \"{name}\" finished"
msgstr "Загрузка «{name}» завершена"

msgid "Upload progress"
msgstr "Ход загрузки"

msgid "Upload progress: {progress}%"
msgstr "Ход загрузки: {progress}%"

msgid "Upload progress: {progress}%, total size {size}"
msgstr "Ход загрузки: {progress}%, общий размер {size}"

msgid "Upload started"
msgstr "Загрузка началась"

msgid "Upload started: {count} file"
msgid_plural "Upload started: {count} files"
msgstr[0] "Начата загрузка {count} файла"
msgstr[1] "Начата загрузка {count} файлов"
msgstr[2] "Начата загрузка {count} файлов"
msgstr[3] "Начата загрузка {count} файла"

msgid "Upload started: {count} file ({size})"
msgid_plural "Upload started: {count} files ({size})"
msgstr[0] "Начата загрузка {count} файла ({size})"
msgstr[1] "Начата загрузка {count} файлов ({size})"
msgstr[2] "Начата загрузка {count} файлов ({size})"
msgstr[3] "Начата загрузка {count} файла ({size})"

msgid "Upload started: {name}"
msgstr "Начата загрузка «{name}»"

msgid "Upload started: {name} ({size})"
msgstr "Начата загрузка «{name}» ({size})"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Если выбрать новую папку, конфликтующие файлы в ней тоже будут перезаписаны."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Если выбрать новую папку, её содержимое будет записано в существующую, а "
"конфликты будут разрешены рекурсивно."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr "Переименуйте файл, пропустите его или отмените всю операцию."

msgid "You need to select at least one version of each file to continue."
msgstr "Чтобы продолжить, выберите хотя бы одну версию каждого файла."
