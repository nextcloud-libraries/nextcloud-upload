msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" е забрането име на датотека или име на папка."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" е забранет вид на датотека."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" не е дозволено во името датотека или папка."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "уште {seconds} секунда"
msgstr[1] "уште {seconds} секунди"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "преостанува {time}"

msgid "a few seconds left"
msgstr "уште неколку секунди"

msgid "All files"
msgstr "Сите датотеки"

msgid "An item with the same name already exists in {dirname}."
msgstr "Ставка со истото име веќе постои во {dirname}."

msgid "assembling"
msgstr "склопување"

msgid "Cancel"
msgstr "Откажи"

msgid "Cancel the entire operation"
msgstr "Откажи ја целата операција"

msgid "Cancel uploads"
msgstr "Прекини прикачување"

msgid "Continue"
msgstr "Продолжи"

msgid "Create new"
msgstr "Креирај нова"

msgid "estimating time left"
msgstr "приближно преостанато време"

msgid "Existing files"
msgstr "Постоечки датотеки"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Постоечките датотеки и папки ќе се избришат ако не се избрани. Ако двете се "
"избрани, тие ќе бидат преименвани."

msgid "Existing version"
msgstr "Постоечка верзија"

msgid "Failed to assemble the chunks together"
msgstr "Неуспешно составување на парчињата заедно"

msgid "Failed to upload the file"
msgstr "Неуспешно прикачување на датотека"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Имињата на датотеките не смеат да завршуваат со \"{segment}\"."

msgid "Invalid filename"
msgstr "Невалидно име на датотека"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Ставка со истото име веќе постои во {dirname}, избери која да се зачува."

msgid "Keep both"
msgstr "Зачувај ги двете"

msgid "Last modified date unknown"
msgstr "Непознат датумот на последната измена"

msgid "New"
msgstr "Нова"

msgid "New filename"
msgstr "Ново име на датотека"

msgid "New files"
msgstr "Нови датотеки"

msgid "New version"
msgstr "Нова верзија"

msgid "paused"
msgstr "паузирано"

msgid "Rename"
msgstr "Преименувај"

msgid "Replace"
msgstr "Преклопи"

msgid "Select all checkboxes"
msgstr "Означи ги сите полиња"

msgid "Select file to keep"
msgstr "Избери датотека за зачувување"

msgid "Select files to keep"
msgstr "Избери датотеки за зачувување"

msgid "Skip"
msgstr "Прескокни"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Прескокни {count} датотека"
msgstr[1] "Прескокни {count} датотеки"

msgid "Unknown size"
msgstr "Непозната големина"

msgid "Upload"
msgstr "Прикачи"

msgid "Upload files"
msgstr "Прикачување датотеки"

msgid "Upload finished"
msgstr "Прикачувањето заврши"

msgid "Upload finished: {count} file uploaded"
msgid_plural "Upload finished: {count} files uploaded"
msgstr[0] "Прикачувањето заврши: {count}датотека е прикачена"
msgstr[1] "Прикачувањето заврши: {count} датотеки се прикачени"

msgid "Upload folders"
msgstr "Прикачи папки"

msgid "Upload from device"
msgstr "Прикачи од уред"

msgid "Upload has been cancelled"
msgstr "Прикачувањето е откажано"

msgid "Upload has been skipped"
msgstr "Прикачувањето е прескокнато"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Прикачувањето на \"{folder}\" е прескокнато"

msgid "Upload of \"{name}\" finished"
msgstr "Прикачувањето на \"{name}\" заврши"

msgid "Upload progress"
msgstr "Прогрес на прикачување"

msgid "Upload progress: {progress}%"
msgstr "Прогрес на прикачување: {progress}%"

msgid "Upload progress: {progress}%, total size {size}"
msgstr "Прогрес на прикачување: {progress}%, вкупна големина {size}"

msgid "Upload started"
msgstr "Прикачувањето започна"

msgid "Upload started: {count} file"
msgid_plural "Upload started: {count} files"
msgstr[0] "Прикачувањето започна: {count}датотека се прикачува"
msgstr[1] "Прикачувањето започна: {count} датотеки се прикачуваат"

msgid "Upload started: {count} file ({size})"
msgid_plural "Upload started: {count} files ({size})"
msgstr[0] "Прикачувањето започна: {count}датотека се прикачува ({size})"
msgstr[1] "Прикачувањето започна: {count} датотеки се прикачуваат ({size})"

msgid "Upload started: {name}"
msgstr "Прикачувањето започна: {name}"

msgid "Upload started: {name} ({size})"
msgstr "Прикачувањето започна: {name} ({size})"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Кога ќе се избере нова папка, сите конфликтни датотеки во неа исто така ќе "
"бидат преклопени."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Кога ќе се избере нова папка, содржината се запишува во постоечката папка и "
"се извршува рекурзивно решавање на конфликтот."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Можете да ја преименувате датотеката, да ја прескокнете датотека или да ја "
"откажете целата операција."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Треба да изберете барем една верзија од секоја датотека за да продолжите."
