msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" é um nome de arquivo ou pasta proibido."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" é um tipo de arquivo proibido."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" não é permitido dentro de um nome de arquivo ou pasta."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} segundo restante"
msgstr[1] "{seconds} segundos restantes"
msgstr[2] "{seconds} segundos restantes"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} restante"

msgid "a few seconds left"
msgstr "alguns segundos restantes"

msgid "All files"
msgstr "Todos os arquivos"

msgid "An item with the same name already exists in {dirname}."
msgstr "Já existe um item com o mesmo nome em {dirname}."

msgid "assembling"
msgstr "montando"

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancel the entire operation"
msgstr "Cancelar a operação inteira"

msgid "Cancel uploads"
msgstr "Cancelar uploads"

msgid "Continue"
msgstr "Continuar"

msgid "Create new"
msgstr "Criar novo"

msgid "estimating time left"
msgstr "estimando tempo restante"

msgid "Existing files"
msgstr "Arquivos existentes"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Os arquivos e pastas existentes serão excluídos se não forem selecionados. "
"Se ambos forem selecionados, serão renomeados."

msgid "Existing version"
msgstr "Versão existente"

msgid "Failed to assemble the chunks together"
msgstr "Falha ao montar os pedaços juntos"

msgid "Failed to upload the file"
msgstr "Falha ao fazer o upload do arquivo"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Os nomes dos arquivos não devem terminar com \"{segment}\"."

msgid "Invalid filename"
msgstr "Nome de arquivo inválido"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Já existem itens com o mesmo nome em {dirname}; selecione qual deles deseja "
"manter."

msgid "Keep both"
msgstr "Manter ambos"

msgid "Last modified date unknown"
msgstr "Data da última modificação desconhecida"

msgid "New"
msgstr "Novo"

msgid "New filename"
msgstr "Novo nome de arquivo"

msgid "New files"
msgstr "Novos arquivos"

msgid "New version"
msgstr "Nova versão"

msgid "paused"
msgstr "pausado"

msgid "Rename"
msgstr "Renomear"

msgid "Replace"
msgstr "Substituir"

msgid "Select all checkboxes"
msgstr "Selecionar todas as caixas de seleção"

msgid "Select file to keep"
msgstr "Selecione o arquivo a ser mantido"

msgid "Select files to keep"
msgstr "Selecione os arquivos a serem mantidos"

msgid "Skip"
msgstr "Pular"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Pular {count} arquivo"
msgstr[1] "Pular {count} de arquivos"
msgstr[2] "Pular {count} arquivos"

msgid "Unknown size"
msgstr "Tamanho desconhecido"

msgid "Upload"
msgstr "Fazer upload"

msgid "Upload files"
msgstr "Fazer upload de arquivos"

msgid "Upload folders"
msgstr "Fazer upload de pastas"

msgid "Upload from device"
msgstr "Fazer upload do dispositivo"

msgid "Upload has been cancelled"
msgstr "O upload foi cancelado"

msgid "Upload has been skipped"
msgstr "O upload foi pulado"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "O upload de \"{folder}\" foi pulado"

msgid "Upload progress"
msgstr "Progresso de upload"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Quando uma nova pasta for selecionada, quaisquer arquivos conflitantes "
"contidos nela também serão sobrescritos."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Quando uma nova pasta for selecionada, o conteúdo é gravado na pasta "
"existente e é realizada uma resolução recursiva de conflitos."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Você pode renomear o arquivo, pular este arquivo ou cancelar toda a "
"operação."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Você precisa selecionar pelo menos uma versão de cada arquivo para "
"continuar."
