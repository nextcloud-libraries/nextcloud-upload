msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" to zabroniona nazwa pliku lub katalogu."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" jest zabronionym typem pliku."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "Znak \"{segment}\" nie jest dozwolony w nazwie pliku lub katalogu."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} sekunda została"
msgstr[1] "{seconds} sekundy zostały"
msgstr[2] "{seconds} sekund zostało"
msgstr[3] "{seconds} sekund zostało"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "Pozostało {time}"

msgid "a few seconds left"
msgstr "Pozostało kilka sekund"

msgid "All files"
msgstr "Wszystkie pliki"

msgid "An item with the same name already exists in {dirname}."
msgstr "Plik o tej samej nazwie już istnieje w {dirname}."

msgid "assembling"
msgstr "składanie"

msgid "Cancel"
msgstr "Anuluj"

msgid "Cancel the entire operation"
msgstr "Anuluj całą operację"

msgid "Cancel uploads"
msgstr "Anuluj wysyłanie"

msgid "Continue"
msgstr "Kontynuuj"

msgid "Create new"
msgstr "Utwórz nowe"

msgid "estimating time left"
msgstr "Szacowanie pozostałego czasu"

msgid "Existing files"
msgstr "Istniejące pliki"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Istniejące pliki i katalogi zostaną usunięte, jeśli nie zostaną zaznaczone. "
"Jeśli wybrano oba, zostaną im nadane nowe nazwy."

msgid "Existing version"
msgstr "Istniejąca wersja"

msgid "Failed to assemble the chunks together"
msgstr "Nie udało się połączyć fragmentów."

msgid "Failed to upload the file"
msgstr "Dodawanie pliku nieudane"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Nazwy plików nie mogą kończyć się na \"{segment}\"."

msgid "Invalid filename"
msgstr "Nieprawidłowa nazwa pliku"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Pliki o tej samej nazwie już istnieją w {dirname}. Wybierz, które chcesz "
"zachować."

msgid "Keep both"
msgstr "Zachowaj oba"

msgid "Last modified date unknown"
msgstr "Nieznana data ostatniej modyfikacji"

msgid "New"
msgstr "Nowy"

msgid "New filename"
msgstr "Nowa nazwa pliku"

msgid "New files"
msgstr "Nowe pliki"

msgid "New version"
msgstr "Nowa wersja"

msgid "paused"
msgstr "Wstrzymane"

msgid "Rename"
msgstr "Zmiana nazwy"

msgid "Replace"
msgstr "Zastąp"

msgid "Select all checkboxes"
msgstr "Zaznacz wszystkie pola wyboru"

msgid "Select file to keep"
msgstr "Wybierz plik, aby zachować"

msgid "Select files to keep"
msgstr "Wybierz pliki, aby zachować"

msgid "Skip"
msgstr "Pomiń"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Pomiń {count} plik"
msgstr[1] "Pomiń {count} pliki"
msgstr[2] "Pomiń {count} plików"
msgstr[3] "Pomiń {count} plików"

msgid "Unknown size"
msgstr "Nieznany rozmiar"

msgid "Upload"
msgstr "Wyślij"

msgid "Upload files"
msgstr "Wyślij pliki"

msgid "Upload finished"
msgstr "Prześlij ukończone"

msgid "Upload finished: {count} file uploaded"
msgid_plural "Upload finished: {count} files uploaded"
msgstr[0] "Przesyłanie ukończone: {count} plik przesłany"
msgstr[1] "Przesyłanie ukończone: {count} pliki przesłane"
msgstr[2] "Przesyłanie ukończone: {count} plików przesłane"
msgstr[3] "Przesyłanie ukończone: {count} plików przesłane"

msgid "Upload folders"
msgstr "Wyślij katalogi"

msgid "Upload from device"
msgstr "Wyślij z urządzenia"

msgid "Upload has been cancelled"
msgstr "Wysyłanie zostało anulowane"

msgid "Upload has been skipped"
msgstr "Wysyłanie zostało pominięte"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Wysyłanie \"{folder}\" zostało pominięte"

msgid "Upload of \"{name}\" finished"
msgstr "Przesyłanie \"{name}\" ukończone"

msgid "Upload progress"
msgstr "Postęp wysyłania"

msgid "Upload progress: {progress}%"
msgstr "Postęp przesyłania: {progress}%"

msgid "Upload progress: {progress}%, total size {size}"
msgstr "Postęp przesyłania: {progress}%, całkowity rozmiar {size}"

msgid "Upload started"
msgstr "Przesyłanie rozpoczęte"

msgid "Upload started: {count} file"
msgid_plural "Upload started: {count} files"
msgstr[0] "Przesyłanie rozpoczęte: {count} plik"
msgstr[1] "Przesyłanie rozpoczęte: {count} pliki"
msgstr[2] "Przesyłanie rozpoczęte: {count} plików"
msgstr[3] "Przesyłanie rozpoczęte: {count} plików"

msgid "Upload started: {count} file ({size})"
msgid_plural "Upload started: {count} files ({size})"
msgstr[0] "Przesyłanie rozpoczęte: {count} plik ({size})"
msgstr[1] "Przesyłanie rozpoczęte: {count} pliki ({size})"
msgstr[2] "Przesyłanie rozpoczęte: {count} plików ({size})"
msgstr[3] "Przesyłanie rozpoczęte: {count} plików ({size})"

msgid "Upload started: {name}"
msgstr "Przesyłanie rozpoczęte: {name}"

msgid "Upload started: {name} ({size})"
msgstr "Przesyłanie rozpoczęte: {name} ({size})"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Po wybraniu nowego katalogu wszystkie znajdujące się w nim pliki powodujące "
"konflikt również zostaną nadpisane."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Po wybraniu nowego katalogu jego zawartość trafi do istniejącego katalogu, a"
" konflikty zostaną rozwiązane rekurencyjnie."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Możesz zmienić nazwę pliku, pominąć ten plik lub anulować całą operację."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Aby kontynuować, musisz wybrać co najmniej jedną wersję każdego pliku."
