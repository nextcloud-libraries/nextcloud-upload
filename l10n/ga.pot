msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "Is ainm toirmiscthe comhaid nó fillteáin é \"{segment}\"."

msgid "\"{segment}\" is a forbidden file type."
msgstr "Is cineál comhaid toirmiscthe é \"{segment}\"."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "Ní cheadaítear \"{segment}\" taobh istigh d'ainm comhaid nó fillteáin."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} soicind fágtha"
msgstr[1] "{seconds} soicind fágtha"
msgstr[2] "{seconds} soicind fágtha"
msgstr[3] "{seconds} soicind fágtha"
msgstr[4] "{seconds} soicind fágtha"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} fágtha"

msgid "a few seconds left"
msgstr "cúpla soicind fágtha"

msgid "All files"
msgstr "Gach comhad"

msgid "An item with the same name already exists in {dirname}."
msgstr "Tá mír leis an ainm céanna ann cheana féin i {dirname}."

msgid "assembling"
msgstr "ag cur le chéile"

msgid "Cancel"
msgstr "Cealaigh"

msgid "Cancel the entire operation"
msgstr "Cealaigh an oibríocht iomlán"

msgid "Cancel uploads"
msgstr "Cealaigh uaslódálacha"

msgid "Continue"
msgstr "Leanúint ar aghaidh"

msgid "Create new"
msgstr "Cruthaigh nua"

msgid "estimating time left"
msgstr "ag déanamh meastachán ar an am atá fágtha"

msgid "Existing files"
msgstr "Comhaid atá ann cheana"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Scriosfar comhaid agus fillteáin atá ann cheana mura roghnaítear iad. Má "
"roghnaítear an dá cheann, athainmneofar iad."

msgid "Existing version"
msgstr "Leagan láithreach "

msgid "Failed to assemble the chunks together"
msgstr "Theip ar na smután a chur le chéile le chéile"

msgid "Failed to upload the file"
msgstr "Theip ar uaslódáil an chomhaid"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Níor cheart go gcríochnaíonn comhaid chomhad le \"{segment}\"."

msgid "Invalid filename"
msgstr "Ainm comhaid neamhbhailí"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Tá míreanna leis an ainm céanna ann cheana féin i {dirname}, roghnaigh cé "
"acu is mian leat a choinneáil."

msgid "Keep both"
msgstr "Coinnigh an dá cheann"

msgid "Last modified date unknown"
msgstr "Dáta modhnaithe is déanaí anaithnid"

msgid "New"
msgstr "Nua"

msgid "New filename"
msgstr "Ainm comhaid nua"

msgid "New files"
msgstr "Comhaid nua"

msgid "New version"
msgstr "Leagan nua"

msgid "paused"
msgstr "sos"

msgid "Rename"
msgstr "Athainmnigh"

msgid "Replace"
msgstr "Athsholáthair"

msgid "Select all checkboxes"
msgstr "Roghnaigh gach ticbhosca"

msgid "Select file to keep"
msgstr "Roghnaigh comhad le coinneáil"

msgid "Select files to keep"
msgstr "Roghnaigh comhaid le coinneáil"

msgid "Skip"
msgstr "Scipeáil"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Léim an comhad {count}"
msgstr[1] "Léim thar {count} comhad"
msgstr[2] "Léim thar {count} comhad"
msgstr[3] "Léim thar {count} comhad"
msgstr[4] "Léim thar {count} comhad"

msgid "Unknown size"
msgstr "Méid anaithnid"

msgid "Upload"
msgstr "Uaslódáil"

msgid "Upload files"
msgstr "Uaslódáil comhaid"

msgid "Upload folders"
msgstr "Uaslódáil fillteáin"

msgid "Upload from device"
msgstr "Íosluchtaigh ó ghléas"

msgid "Upload has been cancelled"
msgstr "Cuireadh an t-uaslódáil ar ceal"

msgid "Upload has been skipped"
msgstr "Léiríodh an uaslódáil"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Léiríodh an uaslódáil \"{folder}\"."

msgid "Upload progress"
msgstr "Uaslódáil dul chun cinn"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Nuair a roghnaítear fillteán nua, déanfar aon chomhaid contrártha ann a "
"athscríobh freisin."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Nuair a roghnaítear fillteán nua, scríobhtar an t-ábhar isteach san "
"fhillteán atá ann cheana féin agus déantar réiteach coinbhleachta "
"athchúrsach."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Is féidir leat an comhad a athainmniú, scipeáil an comhad seo nó an "
"oibríocht iomlán a chealú."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Ní mór duit leagan amháin ar a laghad de gach comhad a roghnú chun leanúint "
"ar aghaidh."
