msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" is een verboden bestands- of mapnaam."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" is een verboden bestandstype."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" is niet toegestaan in een bestand of mapnaam."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} seconde resterend"
msgstr[1] "{seconds} seconden resterend"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} resterend"

msgid "a few seconds left"
msgstr "Nog een paar seconden over"

msgid "All files"
msgstr "Alle bestanden"

msgid "An item with the same name already exists in {dirname}."
msgstr "Er bestaat al een item met dezelfde naam in {dirname}."

msgid "assembling"
msgstr "samenvoegen"

msgid "Cancel"
msgstr "Annuleren"

msgid "Cancel the entire operation"
msgstr "De hele bewerking annuleren"

msgid "Cancel uploads"
msgstr "Uploaden annuleren"

msgid "Continue"
msgstr "Doorgaan"

msgid "Create new"
msgstr "Nieuw aanmaken"

msgid "estimating time left"
msgstr "resterende tijd schatten"

msgid "Existing files"
msgstr "Bestaande bestanden"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Bestaande bestanden en mappen worden verwijderd als ze niet worden "
"geselecteerd. Als beide worden geselecteerd, krijgen ze een nieuwe naam."

msgid "Existing version"
msgstr "Bestaande versie"

msgid "Failed to assemble the chunks together"
msgstr "Segmenten samenvoegen is niet gelukt"

msgid "Failed to upload the file"
msgstr "Het uploaden van het bestand is mislukt"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Bestandsnamen mogen niet eindigen met \"{segment}\"."

msgid "Invalid filename"
msgstr "Ongeldige bestandsnaam"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Er bestaan al items met dezelfde naam in {dirname}, selecteer welk item je "
"wilt behouden."

msgid "Keep both"
msgstr "Bewaar beide"

msgid "Last modified date unknown"
msgstr "Laatst gewijzigde datum onbekend"

msgid "New"
msgstr "Nieuw"

msgid "New filename"
msgstr "Nieuwe bestandsnaam"

msgid "New files"
msgstr "Nieuwe bestanden"

msgid "New version"
msgstr "Nieuwe versie"

msgid "paused"
msgstr "gepauzeerd"

msgid "Rename"
msgstr "Hernoemen"

msgid "Replace"
msgstr "Vervangen"

msgid "Select all checkboxes"
msgstr "Alle opties selecteren"

msgid "Select file to keep"
msgstr "Selecteer bestand om te behouden"

msgid "Select files to keep"
msgstr "Selecteer bestanden om te behouden"

msgid "Skip"
msgstr "Overslaan"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "{count} bestand overslaan"
msgstr[1] "{count} bestanden overslaan"

msgid "Unknown size"
msgstr "Onbekende grootte"

msgid "Upload"
msgstr "Uploaden"

msgid "Upload files"
msgstr "Upload bestanden"

msgid "Upload folders"
msgstr "Mappen uploaden"

msgid "Upload from device"
msgstr "Uploaden vanaf apparaat"

msgid "Upload has been cancelled"
msgstr "Upload is geanulleerd"

msgid "Upload has been skipped"
msgstr "Upload is overgeslagen"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Upload van \"{folder}\" is overgeslagen"

msgid "Upload progress"
msgstr "Uploadvoortgang"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Wanneer een nieuwe map wordt geselecteerd, worden eventuele conflicterende "
"bestanden daarin ook overschreven."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Wanneer een nieuwe map wordt geselecteerd, wordt de inhoud naar de bestaande"
" map gekopieerd en wordt er een recursieve conflictoplossing uitgevoerd."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Je kunt het bestand een andere naam geven, dit bestand overslaan of de hele "
"bewerking annuleren."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Je moet ten minste één versie van elk bestand selecteren om door te gaan."
