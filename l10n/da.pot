msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" er et forbudt fil- eller mappenavn."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" er en forbudt filtype."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" er ikke tilladt i et fil- eller mappenavn."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} sekund tilbage"
msgstr[1] "{seconds} sekunder tilbage"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} tilbage"

msgid "a few seconds left"
msgstr "et par sekunder tilbage"

msgid "All files"
msgstr "Alle filer"

msgid "An item with the same name already exists in {dirname}."
msgstr "Der findes allerede et element med samme navn i {dirname}."

msgid "assembling"
msgstr "samler"

msgid "Cancel"
msgstr "Annuller"

msgid "Cancel the entire operation"
msgstr "Annuller hele handlingen"

msgid "Cancel uploads"
msgstr "Annuller overførsler"

msgid "Continue"
msgstr "Fortsæt"

msgid "Create new"
msgstr "Opret ny"

msgid "estimating time left"
msgstr "beregner resterende tid"

msgid "Existing files"
msgstr "Eksisterende filer"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Eksisterende filer og mapper slettes, hvis de ikke er valgt. Hvis begge er "
"valgt, bliver de omdøbt."

msgid "Existing version"
msgstr "Eksisterende version"

msgid "Failed to assemble the chunks together"
msgstr "Delene kunne ikke samles"

msgid "Failed to upload the file"
msgstr "Filen kunne ikke overføres"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Filnavne må ikke slutte med \"{segment}\"."

msgid "Invalid filename"
msgstr "Ugyldigt filnavn"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Der findes allerede elementer med samme navn i {dirname}. Vælg, hvilke der "
"skal beholdes."

msgid "Keep both"
msgstr "Behold begge"

msgid "Last modified date unknown"
msgstr "Ukendt dato for seneste ændring"

msgid "New"
msgstr "Ny"

msgid "New filename"
msgstr "Nyt filnavn"

msgid "New files"
msgstr "Nye filer"

msgid "New version"
msgstr "Ny version"

msgid "paused"
msgstr "sat på pause"

msgid "Rename"
msgstr "Omdøb"

msgid "Replace"
msgstr "Erstat"

msgid "Select all checkboxes"
msgstr "Vælg alle felter"

msgid "Select file to keep"
msgstr "Vælg fil, der skal beholdes"

msgid "Select files to keep"
msgstr "Vælg filer, der skal beholdes"

msgid "Skip"
msgstr "Spring over"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Spring {count} fil over"
msgstr[1] "Spring {count} filer over"

msgid "Unknown size"
msgstr "Ukendt størrelse"

msgid "Upload"
msgstr "Overfør"

msgid "Upload files"
msgstr "Overfør filer"

msgid "Upload finished"
msgstr "Overførslen er færdig"

msgid "Upload finished: {count} file uploaded"
msgid_plural "Upload finished: {count} files uploaded"
msgstr[0] "Overførslen er færdig: {count} fil er overført"
msgstr[1] "Overførslen er færdig: {count} filer er overført"

msgid "Upload folders"
msgstr "Overfør mapper"

msgid "Upload from device"
msgstr "Overfør fra enhed"

msgid "Upload has been cancelled"
msgstr "Overførslen er annulleret"

msgid "Upload has been skipped"
msgstr "Overførslen er sprunget over"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Overførslen af \"{folder}\" er sprunget over"

msgid "Upload of \"{name}\" finished"
msgstr "Overførslen af \"{name}\" er færdig"

msgid "Upload progress"
msgstr "Overførselsstatus"

msgid "Upload progress: {progress}%"
msgstr "Overførselsstatus: {progress} %"

msgid "Upload progress: {progress}%, total size {size}"
msgstr "Overførselsstatus: {progress} %, samlet størrelse {size}"

msgid "Upload started"
msgstr "Overførslen er startet"

msgid "Upload started: {count} file"
msgid_plural "Upload started: {count} files"
msgstr[0] "Overførslen er startet: {count} fil"
msgstr[1] "Overførslen er startet: {count} filer"

msgid "Upload started: {count} file ({size})"
msgid_plural "Upload started: {count} files ({size})"
msgstr[0] "Overførslen er startet: {count} fil ({size})"
msgstr[1] "Overførslen er startet: {count} filer ({size})"

msgid "Upload started: {name}"
msgstr "Overførslen er startet: {name}"

msgid "Upload started: {name} ({size})"
msgstr "Overførslen er startet: {name} ({size})"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Når en ny mappe vælges, bliver filer i den, der er i konflikt, også "
"overskrevet."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Når en ny mappe vælges, skrives indholdet ind i den eksisterende mappe, og "
"konflikter løses også i alle undermapper."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Du kan enten omdøbe filen, springe denne fil over eller annullere hele "
"handlingen."

msgid "You need to select at least one version of each file to continue."
msgstr "Du skal vælge mindst én version af hver fil for at fortsætte."
