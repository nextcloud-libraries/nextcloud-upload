msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" er bannað sem heiti á skrá eða möppu."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" er bönnuð skráartegund."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" er ekki leyfilegt innan í heiti á skrá eða möppu."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} sekúnda eftir"
msgstr[1] "{seconds} sekúndur eftir"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} eftir"

msgid "a few seconds left"
msgstr "nokkrar sekúndur eftir"

msgid "All files"
msgstr "Allar skrár"

msgid "An item with the same name already exists in {dirname}."
msgstr "Atriði með sama heiti eru þegar til staðar í {dirname}."

msgid "assembling"
msgstr "set saman"

msgid "Cancel"
msgstr "Hætta við"

msgid "Cancel the entire operation"
msgstr "Hætta við alla aðgerðina"

msgid "Cancel uploads"
msgstr "Hætta við innsendingar"

msgid "Continue"
msgstr "Halda áfram"

msgid "Create new"
msgstr "Búa til nýtt"

msgid "estimating time left"
msgstr "áætla tíma sem eftir er"

msgid "Existing files"
msgstr "Fyrirliggjandi skrár"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Fyrirliggjandi skrám og möppum verður eytt ef þær eru ekki valdar. Ef báðar "
"eru valdar verða þær endurnefndar."

msgid "Existing version"
msgstr "Fyrirliggjandi útgáfa"

msgid "Failed to assemble the chunks together"
msgstr "Mistókst að setja saman bútana"

msgid "Failed to upload the file"
msgstr "Mistókst að senda inn skrána"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Skráaheiti mega ekki enda á \"{segment}\"."

msgid "Invalid filename"
msgstr "Ógilt skráarheiti"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Atriði með sama heiti eru þegar til staðar í {dirname}, veldu hverjum þeirra"
" þú vilt halda."

msgid "Keep both"
msgstr "Halda báðum"

msgid "Last modified date unknown"
msgstr "Síðasta breytingadagsetning er óþekkt"

msgid "New"
msgstr "Nýtt"

msgid "New filename"
msgstr "Nýtt skráarheiti"

msgid "New files"
msgstr "Nýjar skrár"

msgid "New version"
msgstr "Ný útgáfa"

msgid "paused"
msgstr "í bið"

msgid "Rename"
msgstr "Endurnefna"

msgid "Replace"
msgstr "Skipta út"

msgid "Select all checkboxes"
msgstr "Velja gátreiti"

msgid "Select file to keep"
msgstr "Veldu skrá til að halda"

msgid "Select files to keep"
msgstr "Veldu skrár til að halda"

msgid "Skip"
msgstr "Sleppa"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Sleppa {count} skrá"
msgstr[1] "Sleppa {count} skrám"

msgid "Unknown size"
msgstr "Óþekkt stærð"

msgid "Upload"
msgstr "Senda inn"

msgid "Upload files"
msgstr "Senda inn skrár"

msgid "Upload folders"
msgstr "Senda inn möppur"

msgid "Upload from device"
msgstr "Senda inn frá tæki"

msgid "Upload has been cancelled"
msgstr "Hætt hefur verið við innsendingu"

msgid "Upload has been skipped"
msgstr "Innsendingu hefur verið sleppt"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Innsendingu á \"{folder}\" hefur verið sleppt"

msgid "Upload progress"
msgstr "Framvinda innsendingar"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Þegar ný mappa er valin, verður einnig skrifað yfir allar skrár í henni sem "
"valda árekstrum."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Þegar valin er ný mappa, verður efnið skrifað inn í fyrirliggjandi möppu og "
"farið í að leysa úr árekstrum."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Þú getur annaðhvort endurnefnt skrána, sleppt þessari skrá eða hætt við alla"
" þessa aðgerð."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Þú verður að velja að minnsta kosti eina útgáfu af hverri skrá til að halda "
"áfram."
