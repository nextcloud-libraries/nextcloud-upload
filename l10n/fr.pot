msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" est un nom de fichier ou de dossier interdit."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" est un type de fichier interdit."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr ""
"\"{segment}\" n'est pas autorisé dans le nom d'un fichier ou d'un dossier."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} seconde restante"
msgstr[1] "{seconds} secondes restantes"
msgstr[2] "{seconds} secondes restantes"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "{time} restant"

msgid "a few seconds left"
msgstr "quelques secondes restantes"

msgid "All files"
msgstr "Tous les fichiers"

msgid "An item with the same name already exists in {dirname}."
msgstr "Un élément avec le même nom existe déjà dans {dirname}."

msgid "assembling"
msgstr "assemblage"

msgid "Cancel"
msgstr "Annuler"

msgid "Cancel the entire operation"
msgstr "Annuler toute l'opération"

msgid "Cancel uploads"
msgstr "Annuler les téléversements"

msgid "Continue"
msgstr "Continuer"

msgid "Create new"
msgstr "Créer un nouveau"

msgid "estimating time left"
msgstr "estimation du temps restant"

msgid "Existing files"
msgstr "Fichiers existants"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Les fichiers et dossiers existants seront supprimés s'ils ne sont pas "
"sélectionnés. Si les deux sont choisis, ils seront renommés."

msgid "Existing version"
msgstr "Version existante"

msgid "Failed to assemble the chunks together"
msgstr "Échec de l'assemblage des morceaux"

msgid "Failed to upload the file"
msgstr "Échec de téléversement du fichier"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Les noms des fichiers ne doivent pas terminer par \"{segment}\"."

msgid "Invalid filename"
msgstr "Nom de fichier invalide"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Des éléments avec des noms identiques existent déjà dans {dirname}, "
"sélectionnez ceux à garder."

msgid "Keep both"
msgstr "Garder les deux"

msgid "Last modified date unknown"
msgstr "Date de la dernière modification inconnue"

msgid "New"
msgstr "Nouveau"

msgid "New filename"
msgstr "Nouveau nom de fichier"

msgid "New files"
msgstr "Nouveaux fichiers"

msgid "New version"
msgstr "Nouvelle version"

msgid "paused"
msgstr "en pause"

msgid "Rename"
msgstr "Renommer"

msgid "Replace"
msgstr "Remplacer"

msgid "Select all checkboxes"
msgstr "Sélectionner toutes les cases à cocher"

msgid "Select file to keep"
msgstr "Sélectionner le fichier à garder"

msgid "Select files to keep"
msgstr "Sélectionner les fichiers à garder"

msgid "Skip"
msgstr "Ignorer"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "{count} fichier ignoré"
msgstr[1] "Ignorer ces {count} fichiers"
msgstr[2] "Ignorer ces {count} fichiers"

msgid "Unknown size"
msgstr "Taille inconnue"

msgid "Upload"
msgstr "Téléverser"

msgid "Upload files"
msgstr "Téléverser des fichiers"

msgid "Upload folders"
msgstr "Téléverser des dossiers"

msgid "Upload from device"
msgstr "Téléverser depuis l'appareil"

msgid "Upload has been cancelled"
msgstr "Le téléversement a été annulé"

msgid "Upload has been skipped"
msgstr "Le téléversement a été ignoré"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Le téléversement de \"{folder}\" a été ignoré"

msgid "Upload progress"
msgstr "Progression du téléversement"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Lorsqu'un nouveau dossier est sélectionné, tous les fichiers en conflit "
"qu'il contient seront également écrasés."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Lorsqu'un nouveau dossier est sélectionné, le contenu est écrit dans le "
"dossier existant et une résolution récursive des conflits est effectuée."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Vous pouvez soit renommer le fichier, soit ignorer le fichier, soit annuler "
"toute l'opération."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Vous devez sélectionner au moins une version de chaque fichier pour "
"continuer."
