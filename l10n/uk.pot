msgid ""
msgstr ""
"Last-Translator: O St, 2026\n"
"Language-Team: Ukrainian (https://app.transifex.com/nextcloud/teams/64236/uk/)\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: uk\n"
"Plural-Forms: nplurals=4; plural=(n % 1 == 0 && n % 10 == 1 && n % 100 != 11 ? 0 : n % 1 == 0 && n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 1 : n % 1 == 0 && (n % 10 ==0 || (n % 10 >=5 && n % 10 <=9) || (n % 100 >=11 && n % 100 <=14 )) ? 2: 3);\n"

msgid "\"{segment}\" is a forbidden file or folder name."
msgstr "\"{segment}\" недозволене ім'я файлу або каталогу."

msgid "\"{segment}\" is a forbidden file type."
msgstr "\"{segment}\" недозволений тип файлу."

msgid "\"{segment}\" is not allowed inside a file or folder name."
msgstr "\"{segment}\" недозволене сполучення символів в назві файлу або каталогу."

msgid "{seconds} seconds left"
msgid_plural "{seconds} seconds left"
msgstr[0] "{seconds} секунда залишилася"
msgstr[1] "{seconds} секунди залишилося"
msgstr[2] "{seconds} секунд залишилося"
msgstr[3] "{seconds} секунд залишилося"

#. TRANSLATORS time has the format 00:00:00
msgid "{time} left"
msgstr "Залишилося {time}"

msgid "a few seconds left"
msgstr "залишилося кілька секунд"

msgid "All files"
msgstr "Всі файли"

msgid "An item with the same name already exists in {dirname}."
msgstr "Об'єкт з таким ім'ям присутній у {dirname}."

msgid "assembling"
msgstr "збірка"

msgid "Cancel"
msgstr "Скасувати"

msgid "Cancel the entire operation"
msgstr "Скасувати операцію повністю"

msgid "Cancel uploads"
msgstr "Скасувати завантаження"

msgid "Continue"
msgstr "Продовжити"

msgid "Create new"
msgstr "Створити новий"

msgid "estimating time left"
msgstr "оцінка часу, що залишився"

msgid "Existing files"
msgstr "Присутні файли"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Присутні файли та каталоги буде вилучено, якщо не вибрано. Якщо вибрано "
"обидва, то їх буде перейменовано."

msgid "Existing version"
msgstr "Присутня версія"

msgid "Failed to assemble the chunks together"
msgstr "Не вдалося зібрати частинки докупи"

msgid "Failed to upload the file"
msgstr "Не вдалося завантажити файл"

msgid "Filenames must not end with \"{segment}\"."
msgstr "Ім'я файлів не можуть закінчуватися на \"{segment}\"."

msgid "Invalid filename"
msgstr "Недійсне ім'я файлу"

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Об'єкти з тотожнім ім'ям присутні у {dirname}, виберіть, які потрібно "
"зберегти."

msgid "Keep both"
msgstr "Зберегти обидва"

msgid "Last modified date unknown"
msgstr "Дата останньої зміни невідома"

msgid "New"
msgstr "Нове"

msgid "New filename"
msgstr "Нове ім'я файлу"

msgid "New files"
msgstr "Нові файли"

msgid "New version"
msgstr "Нова версія"

msgid "paused"
msgstr "призупинено"

msgid "Rename"
msgstr "Перейменувати"

msgid "Replace"
msgstr "Замінити"

msgid "Select all checkboxes"
msgstr "Вибрати все"

msgid "Select file to keep"
msgstr "Виберіть файл, який потрібно зберегти"

msgid "Select files to keep"
msgstr "Виберіть файли, які потрібно зберегти"

msgid "Skip"
msgstr "Пропустити"

msgid "Skip {count} file"
msgid_plural "Skip {count} files"
msgstr[0] "Пропустити {count} файл"
msgstr[1] "Пропустити {count} файли"
msgstr[2] "Пропустити {count} файлів"
msgstr[3] "Пропустити {count} файлів"

msgid "Unknown size"
msgstr "Невідомий розмір"

msgid "Upload"
msgstr "Завантажити"

msgid "Upload files"
msgstr "Завантажити файли"

msgid "Upload folders"
msgstr "Завантажити каталоги"

msgid "Upload from device"
msgstr "Завантажити з пристрою"

msgid "Upload has been cancelled"
msgstr "Завантаження скасовано"

msgid "Upload has been skipped"
msgstr "Завантаження пропущено"

msgid "Upload of \"{folder}\" has been skipped"
msgstr "Завантаження \"{folder}\" пропущено"

msgid "Upload progress"
msgstr "Поступ завантаження"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Якщо вибрано новий каталог, всі файли з конфліктами буде також перезаписано."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Якщо вибрано новий каталог, всі об'єкти буде записано до цього каталогу, "
"застосовано рекурсивне розв'язання конфліктів."

msgid ""
"You can either rename the file, skip this file or cancel the whole "
"operation."
msgstr ""
"Ви можете або перейменувати цей файл, пропустити або скасувати дію з файлом."

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Для продовження потрібно вибрати принаймні одну версію для кожного файлу."
